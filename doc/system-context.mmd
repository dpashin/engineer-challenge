%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#E3F2FD', 'primaryTextColor': '#1A1A1A', 'primaryBorderColor': '#1565C0', 'lineColor': '#1565C0', 'secondaryColor': '#FFF3E0', 'tertiaryColor': '#E8F5E9' } } }%%
stateDiagram-v2
    direction TB

    %% Пользователь
    state "Пользователь\n(человек)" as User {
        state "Взаимодействует с фронтендом" as UserAction
    }

    %% Frontend
    state "Frontend\n(клиентское приложение)" as Frontend {
        state "Формы регистрации,\nавторизации и\nвосстановления пароля" as Forms
    }

    %% Backend - Presentation Layer
    state "Backend\n(Presentation Layer)" as Presentation {
        state "GraphQL API\n(Apollo Server)" as GraphQL
        state "Rate Limit Interceptor\n(decorator + interceptor)" as RateLimitInterceptor
    }

    %% Backend - Command Side
    state "Backend\n(Command Side)" as CommandSide {
        state "Command Handlers\n(Register, Login, Reset, etc.)" as Handlers
        state "Domain Model\n(бизнес-правила,\nинварианты, агрегаты)" as DomainModel
    }

    %% Backend - Query Side
    state "Backend\n(Query Side)" as QuerySide {
        state "Query Handlers\n(GetUser, etc.)" as QueryHandlers
    }

    %% Backend - Infrastructure
    state "Backend\n(Infrastructure Layer)" as Infrastructure {
        state "Repositories\n(User, Token)" as Repositories
        state "Services\n(Email, Token, Hasher)" as Services
        state "Cron Service\n(cleanup expired tokens)" as CronService
    }

    %% PostgreSQL
    state "PostgreSQL\n(хранилище данных)" as Database {
        state "Таблицы:\nusers, password_reset_tokens,\nrefresh_tokens" as Tables
    }

    %% Redis
    state "Redis\n(sliding window log storage)" as Redis

    %% SMTP
    state "SMTP Server\n(Mailcatcher / Production)" as SMTP

    %% Связи - User Flow
    User --> Frontend: "Вводит данные\n(логин, пароль, email)"
    Frontend --> GraphQL: "GraphQL запросы/мутации"

    %% Связи - Rate Limiting
    GraphQL --> RateLimitInterceptor: "Перехват запроса"
    RateLimitInterceptor --> Redis: "Проверка лимитов\n(sliding window)"
    Redis --> RateLimitInterceptor: "allowed/remaining\nretryAfter"
    RateLimitInterceptor --> Handlers: "Если OK"

    %% Связи - Command Flow
    Handlers --> DomainModel: "Применяет\nбизнес-правила"
    Handlers --> Repositories: "Запись/чтение данных"
    Repositories --> Database: "SQL запросы"
    Database --> Repositories: "Результат"

    %% Связи - Services
    Handlers --> Services: "Использует сервисы"
    Services --> SMTP: "Отправка email\n(password reset)"

    %% Связи - Query Flow
    QuerySide --> QueryHandlers: "Обработка запросов"
    QueryHandlers --> Repositories: "Чтение данных"
    Repositories --> Database: "SQL запросы"

    %% Связи - Cron
    CronService --> Database: "Очистка устаревших\nтокенов (daily 3AM)"

    %% Связи - Domain Model
    DomainModel --> Repositories: "Проверка инвариантов"
