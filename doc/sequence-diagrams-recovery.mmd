%% Password Recovery Process
%% File: sequence-diagrams-recovery.mmd
sequenceDiagram
    autonumber
    actor User
    participant Frontend as Frontend
    participant API as GraphQL API
    participant RateLimit as Rate Limit Service
    participant Redis as Redis
    participant Command as Command Side
    participant Domain as Domain Model
    participant UserRepo as User Repository
    participant ResetTokenRepo as Reset Token Repository
    participant EmailService as Email Service
    participant DB as PostgreSQL

    User->>Frontend: Click Forgot Password
    Frontend->>API: POST /graphql (RequestPasswordResetMutation)
    API->>Command: Handle RequestPasswordResetCommand

    %% Rate Limit Check by Email
    Command->>RateLimit: Check Rate Limit (by email)
    RateLimit->>Redis: Check password reset requests (sliding window)
    alt Rate limit exceeded
        Redis-->>RateLimit: Count > limit
        RateLimit-->>Command: RATE_LIMITED + retryAfter
        Command-->>API: RequestPasswordResetError.RATE_LIMITED
        API-->>Frontend: Try again in 30 min
        Frontend-->>User: Too many attempts
    else Rate limit OK
        Redis-->>RateLimit: Allowed
        RateLimit-->>Command: Allowed

        Command->>UserRepo: Find User by Email
        UserRepo->>DB: Query user by email
        alt User not found
            DB-->>UserRepo: No user found
            UserRepo-->>Command: null
            note over Command: Return success to prevent email enumeration
            Command-->>API: Success (no email sent)
            API-->>Frontend: Success
            Frontend-->>User: Check your email
        else User found
            DB-->>UserRepo: User data
            UserRepo-->>Command: User entity

            %% Check if user is blocked
            alt User is blocked (reset_request_blocked_until)
                Command-->>API: RequestPasswordResetError.RATE_LIMITED
                API-->>Frontend: Blocked
                Frontend-->>User: Try again later
            else User is not blocked
                Command->>ResetTokenRepo: Invalidate all existing tokens
                ResetTokenRepo->>DB: Revoke previous tokens
                DB-->>ResetTokenRepo: Done
                ResetTokenRepo-->>Command: Done

                Command->>Domain: Generate Crypto-Secure Reset Token
                Domain->>Domain: Generate 128+ bit entropy token
                Command->>Domain: Hash Reset Token (SHA-256)
                Command->>ResetTokenRepo: Store Token Hash + Expiration (10 min)
                ResetTokenRepo->>DB: Store token
                DB-->>ResetTokenRepo: Token stored
                ResetTokenRepo-->>Command: Done

                Command->>EmailService: Send password reset email
                EmailService-->>Command: Email sent
                Command-->>API: Success
                API-->>Frontend: Success
                Frontend-->>User: Check your email
            end
        end
    end

    %% === Reset Password with Token ===
    User->>Frontend: Enter reset token from email
    Frontend->>API: POST /graphql (ResetPasswordMutation)
    API->>Command: Handle ResetPasswordCommand

    Command->>Domain: Hash Submitted Token (SHA-256)
    Command->>ResetTokenRepo: Find token by hash
    ResetTokenRepo->>DB: Query token hash and expiration
    alt Token invalid or not found
        DB-->>ResetTokenRepo: No token found
        ResetTokenRepo-->>Command: null
        Command-->>API: ResetPasswordError.INVALID_TOKEN
        API-->>Frontend: Error message
        Frontend-->>User: Invalid or expired token
    else Token found
        DB-->>ResetTokenRepo: Token data
        ResetTokenRepo-->>Command: Token entity

        alt Token expired
            Command-->>API: ResetPasswordError.TOKEN_EXPIRED
            API-->>Frontend: Error message
            Frontend-->>User: Token expired
        else Token used
            Command-->>API: ResetPasswordError.TOKEN_ALREADY_USED
            API-->>Frontend: Error message
            Frontend-->>User: Token already used
        else Token revoked
            Command-->>API: ResetPasswordError.INVALID_TOKEN
            API-->>Frontend: Error message
            Frontend-->>User: Token revoked
        else Token valid
            Command->>Domain: Validate Password Strength
            Domain->>Domain: Check length >= 8 chars
            Domain->>Domain: Check uppercase, lowercase, digits, special chars
            alt Password weak
                Domain-->>Command: WeakPasswordError
                Command-->>API: ResetPasswordError.INVALID_PASSWORD
                API-->>Frontend: Error message
                Frontend-->>User: Password requirements not met
            else Password strong
                Domain-->>Command: Password valid
                Command->>Domain: Hash New Password (bcrypt)
                Command->>UserRepo: Update password hash
                UserRepo->>DB: Update password_hash
                DB-->>UserRepo: Password updated
                UserRepo-->>Command: Done

                Command->>ResetTokenRepo: Mark token as used
                ResetTokenRepo->>DB: Set used_at
                DB-->>ResetTokenRepo: Done
                ResetTokenRepo-->>Command: Done

                Command->>ResetTokenRepo: Invalidate all other tokens for user
                ResetTokenRepo->>DB: Revoke remaining tokens
                DB-->>ResetTokenRepo: Done
                ResetTokenRepo-->>Command: Done

                Command-->>API: ResetPasswordResult { success: true }
                API-->>Frontend: Success
                Frontend-->>User: Password changed
            end
        end
    end

    %% Error Handling
    note over Command: catch (error)
    Command-->>API: ResetPasswordError.INTERNAL_ERROR
    API-->>Frontend: Error message
    Frontend-->>User: Password reset failed
