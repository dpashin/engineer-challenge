%% Password Recovery Process
%% File: sequence-diagrams-recovery.mmd
%% Updated: 2026-03-11
%% Changes: Fixed Rate Limit location (Presentation layer), clarified token handling
sequenceDiagram
    autonumber
    actor User
    participant Frontend as Frontend
    participant API as GraphQL API
    participant RateLimit as Rate Limit Interceptor
    participant Redis as Redis
    participant Command as Command Handler
    participant ResetTokenPolicy as ResetTokenPolicyService
    participant UserRepo as User Repository
    participant ResetTokenRepo as Reset Token Repository
    participant EmailService as Email Service
    participant SMTP as SMTP Server
    participant DB as PostgreSQL

    %% === Request Password Reset ===
    User->>Frontend: Click Forgot Password, enter email
    Frontend->>API: POST /graphql (RequestPasswordResetMutation)
    
    %% Rate Limit Check (in Presentation Layer)
    API->>RateLimit: Intercept request
    RateLimit->>RateLimit: Check @RateLimit(PASSWORD_RESET_BY_EMAIL, 'email')
    RateLimit->>Redis: Check password reset requests (sliding window)
    alt Rate limit exceeded
        Redis-->>RateLimit: Count > limit
        RateLimit-->>API: Throw RateLimitExceededException
        API-->>Frontend: Error: RATE_LIMITED + retryAfter (30 min)
        Frontend-->>User: Too many attempts. Try again later
    else Rate limit OK
        Redis-->>RateLimit: Allowed
        RateLimit->>Command: Execute RequestPasswordResetCommand

        Command->>UserRepo: findByEmail(email)
        UserRepo->>DB: SELECT * FROM users WHERE email = ?
        alt User not found
            DB-->>UserRepo: No user found
            UserRepo-->>Command: null
            note over Command: Return success to prevent<br/>email enumeration attack
            Command-->>API: Success (no email sent)
            API-->>Frontend: Success
            Frontend-->>User: Check your email (if exists)
        else User found
            DB-->>UserRepo: User data (id, resetRequestBlockedUntil, failedResetAttempts)
            UserRepo-->>Command: User entity

            %% Check if user is blocked from reset requests
            alt User is blocked (resetRequestBlockedUntil > now)
                Command-->>API: RequestPasswordResetError.RATE_LIMITED
                API-->>Frontend: Error: Blocked
                Frontend-->>User: Try again later
            else User is not blocked
                %% Invalidate all existing reset tokens for this user
                Command->>ResetTokenRepo: invalidateAllUserTokens(userId)
                ResetTokenRepo->>DB: UPDATE password_reset_tokens SET revoked_at = NOW() WHERE user_id = ?
                DB-->>ResetTokenRepo: Done
                ResetTokenRepo-->>Command: Done

                %% Generate crypto-secure reset token
                Command->>ResetTokenPolicy: getTokenExpirationDate()
                ResetTokenPolicy->>ResetTokenPolicy: now + 10 minutes
                ResetTokenPolicy-->>Command: expiresAt

                Command->>Command: Generate secure random token (128+ bit entropy)
                Command->>Command: Hash token with SHA-256
                note over Command: Store hash, not raw token<br/>for security

                Command->>ResetTokenRepo: create(userId, tokenHash, expiresAt)
                ResetTokenRepo->>DB: INSERT INTO password_reset_tokens (user_id, token_hash, expires_at)
                DB-->>ResetTokenRepo: Token stored
                ResetTokenRepo-->>Command: Done

                %% Send password reset email
                Command->>EmailService: sendPasswordResetEmail(user.email, rawToken)
                EmailService->>SMTP: Send email with reset link
                SMTP-->>EmailService: Email sent
                EmailService-->>Command: Done

                note over API: Token NOT returned in API response<br/>Sent only via email
                Command-->>API: Success
                API-->>Frontend: Success
                Frontend-->>User: Check your email
            end
        end
    end

    %% === Reset Password with Token ===
    User->>Frontend: Enter reset token from email + new password
    Frontend->>API: POST /graphql (ResetPasswordMutation)
    API->>Command: Execute ResetPasswordCommand

    Command->>Command: Hash submitted token (SHA-256)
    Command->>ResetTokenRepo: findByToken(tokenHash)
    ResetTokenRepo->>DB: SELECT * FROM password_reset_tokens WHERE token_hash = ?
    alt Token invalid or not found
        DB-->>ResetTokenRepo: No token found
        ResetTokenRepo-->>Command: null
        Command-->>API: ResetPasswordError.INVALID_TOKEN
        API-->>Frontend: Error: Invalid token
        Frontend-->>User: Invalid or expired token
    else Token found
        DB-->>ResetTokenRepo: Token data (id, user_id, expires_at, used_at, revoked_at)
        ResetTokenRepo-->>Command: Token entity

        alt Token expired (expiresAt < now)
            Command-->>API: ResetPasswordError.TOKEN_EXPIRED
            API-->>Frontend: Error: Token expired
            Frontend-->>User: Token has expired
        else Token already used (usedAt != null)
            Command-->>API: ResetPasswordError.TOKEN_ALREADY_USED
            API-->>Frontend: Error: Token used
            Frontend-->>User: Token already used
        else Token revoked (revokedAt != null)
            Command-->>API: ResetPasswordError.INVALID_TOKEN
            API-->>Frontend: Error: Token revoked
            Frontend-->>User: Token revoked
        else Token valid
            %% Validate new password
            Command->>Command: validatePassword(newPassword)
            Command->>Command: Check length >= 8 chars
            Command->>Command: Check uppercase, lowercase, digits, special chars
            alt Password weak
                Command-->>API: ResetPasswordError.INVALID_PASSWORD
                API-->>Frontend: Error: Password requirements not met
                Frontend-->>User: Password too weak
            else Password strong
                %% Hash new password
                Command->>Command: hashPassword(newPassword)
                Command->>Command: bcrypt.hash(newPassword, saltRounds=12)

                %% Update password
                Command->>UserRepo: changePassword(userId, newPasswordHash)
                UserRepo->>DB: UPDATE users SET password_hash = ? WHERE id = ?
                DB-->>UserRepo: Password updated
                UserRepo-->>Command: Done

                %% Mark token as used
                Command->>ResetTokenRepo: markAsUsed(tokenId)
                ResetTokenRepo->>DB: UPDATE password_reset_tokens SET used_at = NOW() WHERE id = ?
                DB-->>ResetTokenRepo: Done
                ResetTokenRepo-->>Command: Done

                %% Invalidate all other tokens for this user
                Command->>ResetTokenRepo: invalidateAllUserTokens(userId)
                ResetTokenRepo->>DB: UPDATE password_reset_tokens SET revoked_at = NOW() WHERE user_id = ? AND id != ?
                DB-->>ResetTokenRepo: Done
                ResetTokenRepo-->>Command: Done

                Command-->>API: ResetPasswordResult { success: true }
                API-->>Frontend: Success
                Frontend-->>User: Password changed successfully
            end
        end
    end

    %% Error Handling
    note over Command: catch (error)
    Command-->>API: ResetPasswordError.INTERNAL_ERROR
    API-->>Frontend: Error message
    Frontend-->>User: Password reset failed
